{
  "info": {
    "name": "SIPAKARBUN - Mahasiswa 1 (Knowledge Management)",
    "description": "Koleksi endpoint CRUD internal (/api/admin/*) dan kontrak publik untuk Mahasiswa 2 (/api/penyakit, /api/gejala).\n\n## Cara pakai\n1. Jalankan `php artisan serve` di project Laravel.\n2. Buat user + token lewat tinker (lihat API_DOCUMENTATION_Mahasiswa_1.md).\n3. Isi variabel `base_url` dan `token` di tab Variables.\n4. Jalankan request secara berurutan: Buat -> Detail -> Update -> Hapus.\n   Test script otomatis menangkap ID dari response Buat dan menyimpannya ke variabel.\n\nLihat API_DOCUMENTATION_Mahasiswa_1.md dan KONTRAK_API_M1_ke_M2.md untuk detail lengkap.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "1|i3PUvMsUW1hhzN7z7YY7ggx35PobRHmMXf83TpS67af99d01" },
    { "key": "penyakit_id", "value": "1" },
    { "key": "gejala_id", "value": "1" },
    { "key": "solusi_id", "value": "1" },
    { "key": "aturan_cf_id", "value": "1" },
    { "key": "komoditas_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Admin - Penyakit",
      "description": "CRUD data penyakit tanaman. Hanya role admin dan pakar yang boleh mengakses.",
      "item": [
        {
          "name": "List Penyakit",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/penyakit?aktif_saja=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "penyakit"],
              "query": [
                { "key": "aktif_saja", "value": "1", "description": "Filter hanya penyakit berstatus aktif (status=aktif)" },
                { "key": "per_page", "value": "15", "description": "Jumlah data per halaman (max 100)" },
                { "key": "q", "value": "", "disabled": true, "description": "Pencarian berdasarkan kode/nama" }
              ]
            },
            "description": "Menampilkan daftar penyakit dengan pagination. Query param aktif_saja untuk filter status, q untuk pencarian."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response punya data array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});",
                  "pm.test('Pagination fields ada', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('current_page');",
                  "    pm.expect(jsonData).to.have.property('per_page');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Sukses - daftar penyakit",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"current_page\": 1,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"kode\": \"PY-001\",\n      \"nama\": \"Karat Daun Kopi\",\n      \"deskripsi\": \"Penyakit jamur (Hemileia vastatrix) ...\",\n      \"status\": \"aktif\",\n      \"created_at\": \"2026-08-12T10:00:00.000000Z\",\n      \"updated_at\": \"2026-08-12T10:00:00.000000Z\",\n      \"penyakit_komoditas\": [\n        { \"id\": 1, \"penyakit_id\": 1, \"komoditas_id\": 1 }\n      ]\n    }\n  ],\n  \"per_page\": 15,\n  \"total\": 6\n}"
            }
          ]
        },
        {
          "name": "Buat Penyakit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kode\": \"PY-TEST\",\n  \"nama\": \"Penyakit Uji Coba Postman\",\n  \"deskripsi\": \"Deskripsi penyakit dari Postman\",\n  \"status\": \"aktif\",\n  \"komoditas_id\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/penyakit",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "penyakit"]
            },
            "description": "Membuat penyakit baru. komoditas_id opsional — divalidasi lewat KomoditasReferensiClient (mock: id 1-5 valid). ID penyakit baru otomatis disimpan ke variabel penyakit_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response punya id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "});",
                  "pm.test('Response punya nama', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('nama');",
                  "});",
                  "",
                  "// Auto-capture ID untuk request berikutnya",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('penyakit_id', jsonData.id);",
                  "    console.log('penyakit_id disimpan: ' + jsonData.id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Sukses - penyakit dibuat",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 7,\n  \"kode\": \"PY-TEST\",\n  \"nama\": \"Penyakit Uji Coba Postman\",\n  \"deskripsi\": \"Deskripsi penyakit dari Postman\",\n  \"status\": \"aktif\",\n  \"created_at\": \"2026-08-14T09:00:00.000000Z\",\n  \"updated_at\": \"2026-08-14T09:00:00.000000Z\",\n  \"penyakit_komoditas\": [\n    { \"id\": 10, \"penyakit_id\": 7, \"komoditas_id\": 1 },\n    { \"id\": 11, \"penyakit_id\": 7, \"komoditas_id\": 2 }\n  ]\n}"
            },
            {
              "name": "Error - komoditas invalid (422)",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\n  \"message\": \"Komoditas dengan id 999 tidak ditemukan atau tidak aktif di referensi Disbun.\",\n  \"errors\": {\n    \"komoditas_id\": [\n      \"Komoditas dengan id 999 tidak ditemukan atau tidak aktif di referensi Disbun.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Detail Penyakit",
