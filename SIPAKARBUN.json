          "response": [
            {
              "name": "Sukses - detail penyakit",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": 7,\n  \"kode\": \"PY-TEST\",\n  \"nama\": \"Penyakit Uji Coba Postman\",\n  \"deskripsi\": \"Deskripsi penyakit dari Postman\",\n  \"status\": \"aktif\",\n  \"created_at\": \"2026-08-14T09:00:00.000000Z\",\n  \"updated_at\": \"2026-08-14T09:00:00.000000Z\",\n  \"solusi\": [],\n  \"aturan_cf\": [],\n  \"penyakit_komoditas\": [\n    { \"id\": 10, \"penyakit_id\": 7, \"komoditas_id\": 1 },\n    { \"id\": 11, \"penyakit_id\": 7, \"komoditas_id\": 2 }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Update Penyakit",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Penyakit Uji Coba Postman (revisi)\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/penyakit/{{penyakit_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "penyakit", "{{penyakit_id}}"]
            },
            "description": "Memperbarui data penyakit. Update parsial: hanya field yang dikirim yang diubah. Jika komoditas_id tidak dikirim, relasi komoditas tidak dihapus."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nama berubah', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.nama).to.include('revisi');",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Sukses - penyakit diupdate",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": 7,\n  \"kode\": \"PY-TEST\",\n  \"nama\": \"Penyakit Uji Coba Postman (revisi)\",\n  \"deskripsi\": \"Deskripsi penyakit dari Postman\",\n  \"status\": \"aktif\",\n  \"created_at\": \"2026-08-14T09:00:00.000000Z\",\n  \"updated_at\": \"2026-08-14T09:05:00.000000Z\",\n  \"penyakit_komoditas\": [\n    { \"id\": 10, \"penyakit_id\": 7, \"komoditas_id\": 1 },\n    { \"id\": 11, \"penyakit_id\": 7, \"komoditas_id\": 2 }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Hapus Penyakit",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/penyakit/{{penyakit_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "penyakit", "{{penyakit_id}}"]
            },
            "description": "Menghapus penyakit secara permanen (hard delete). Cascade: solusi, aturan CF, dan relasi komoditas terkait juga dihapus."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Sukses - penyakit dihapus",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        }
      ]
    },
